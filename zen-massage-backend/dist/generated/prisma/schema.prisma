generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String       @id @default(cuid())
  email               String       @unique
  password            String
  firstName           String
  lastName            String
  phone               String?
  avatar              String?
  role                UserRole     @default(USER)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  deletedAt           DateTime?
  reset_token         String?      @unique
  reset_token_expires DateTime?
  avis                Avis[]
  likes               Like[]
  rendezVous          RendezVous[]
  commandes           Commande[]
  avis_repondus       Avis[]       @relation("AvisReponses")
  votes_utiles        AvisUtile[]

  @@index([email])
  @@index([role])
}

model Categorie {
  id          String    @id @default(cuid())
  nom         String    @unique
  description String?
  icone       String?
  ordre       Int       @default(0)
  createdAt   DateTime  @default(now())
  produits    Produit[]

  @@index([nom])
}

model Produit {
  id           String          @id @default(cuid())
  nom          String
  description  String
  prix         Float
  stock        Int
  categorie_id String
  images       String[]
  sku_number   Int             @unique @default(autoincrement())
  sku          String?         @unique
  publie       Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  avis         Avis[]
  likes        Like[]
  categorie    Categorie       @relation(fields: [categorie_id], references: [id])
  lignes       LigneCommande[]

  @@index([categorie_id])
  @@index([publie])
}

model Avis {
  id               String      @id @default(cuid())
  note             Int
  titre            String
  contenu          String
  produit_id       String
  utilisateur_id   String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  reponse_admin    String?
  reponse_admin_at DateTime?
  reponse_admin_id String?
  masque           Boolean     @default(false)
  produit          Produit     @relation(fields: [produit_id], references: [id], onDelete: Cascade)
  utilisateur      User        @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade)
  admin_repondant  User?       @relation("AvisReponses", fields: [reponse_admin_id], references: [id], onDelete: SetNull)
  votes_utiles     AvisUtile[]

  @@unique([utilisateur_id, produit_id])
  @@index([produit_id])
  @@index([utilisateur_id])
  @@index([reponse_admin_id])
}

model Like {
  id             String   @id @default(cuid())
  utilisateur_id String
  produit_id     String
  createdAt      DateTime @default(now())
  produit        Produit  @relation(fields: [produit_id], references: [id], onDelete: Cascade)
  utilisateur    User     @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade)

  @@unique([utilisateur_id, produit_id])
  @@index([produit_id])
  @@index([utilisateur_id])
}

model AvisUtile {
  id             String   @id @default(cuid())
  avis_id        String
  utilisateur_id String
  utile          Boolean // true = utile, false = pas utile
  createdAt      DateTime @default(now())
  avis           Avis     @relation(fields: [avis_id], references: [id], onDelete: Cascade)
  utilisateur    User     @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade)

  @@unique([avis_id, utilisateur_id])
  @@index([avis_id])
  @@index([utilisateur_id])
}

model TypeSeance {
  id          String       @id @default(cuid())
  nom         String       @unique
  description String
  duree       Int
  prix        Int
  actif       Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  rendezVous  RendezVous[]
}

model RendezVous {
  id             String            @id @default(cuid())
  utilisateur_id String
  date_heure     DateTime
  duree          Int
  type_seance_id String
  notes          String?
  statut         AppointmentStatus @default(PENDING)
  raison_refus   String?
  notes_admin    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  type_seance    TypeSeance        @relation(fields: [type_seance_id], references: [id])
  utilisateur    User              @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade)

  @@index([utilisateur_id])
  @@index([date_heure])
  @@index([statut])
}

model Configuration {
  id          String   @id @default(cuid())
  cle         String   @unique
  valeur      String
  description String?
  updatedAt   DateTime @updatedAt
}

// ============================================
// COMMANDES
// ============================================

model Commande {
  id              String      @id @default(cuid())
  numero          String      @unique // BEN-CMD-001
  utilisateur_id  String
  statut          OrderStatus @default(PENDING)
  total           Float
  frais_livraison Float       @default(0)
  ville           String
  adresse         String
  telephone       String
  mode_paiement   String
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  utilisateur User            @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade)
  lignes      LigneCommande[]

  @@index([utilisateur_id])
  @@index([statut])
  @@index([numero])
}

model LigneCommande {
  id            String  @id @default(cuid())
  commande_id   String
  produit_id    String
  nom_produit   String // snapshot du nom au moment de la commande
  image         String? // snapshot de l'image
  prix_unitaire Float
  quantite      Int
  sous_total    Float

  commande Commande @relation(fields: [commande_id], references: [id], onDelete: Cascade)
  produit  Produit  @relation(fields: [produit_id], references: [id])

  @@index([commande_id])
}

enum OrderStatus {
  PENDING // En attente
  CONFIRMED // Confirmée
  SHIPPED // Expédiée
  DELIVERED // Livrée
  CANCELLED // Annulée
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}
